rules_version = '2';

// Shared Firebase project: web shop dashboard + Flutter builder app.
// Web owns shops / billing / products. Flutter owns estimates, posts, bids,
// notifications, and saved projects. Default-deny at the bottom — every
// collection used by either client must be listed here.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function shopIsApproved(shopId) {
      return shopId is string
        && exists(/databases/$(database)/documents/shops/$(shopId))
        && get(/databases/$(database)/documents/shops/$(shopId)).data.status is string
        && get(/databases/$(database)/documents/shops/$(shopId)).data.status.matches('(?i)^approved$');
    }

    function isApprovedShop() {
      return signedIn() && shopIsApproved(request.auth.uid);
    }

    // Builder uid on a posted estimate. Canonical field is userId (Auth uid).
    function isPostOwner(data) {
      return signedIn() && (
        data.userId == request.auth.uid
        || data.builderId == request.auth.uid
        || data.ownerId == request.auth.uid
        || data.postedBy == request.auth.uid
      );
    }

    function postDoc(postId) {
      return get(/databases/$(database)/documents/projectPosts/$(postId)).data;
    }

    function ownsPostedEstimate(postId) {
      return isPostOwner(postDoc(postId));
    }

    // ── Admins ──────────────────────────────────────────────────────────────
    match /admins/{adminId} {
      allow read: if isAdmin() || isOwner(adminId);
      allow write: if isAdmin();
    }

    // ── Shops (web dashboard + builder ranking of approved shops) ───────────
    match /shops/{shopId} {
      allow read: if isOwner(shopId) || isAdmin()
                  || (signedIn() && resource.data.status == "approved");

      allow create: if isOwner(shopId)
        && request.resource.data.subscriptionPlan == "basic"
        && request.resource.data.status == "pending";

      // Owners may edit profile fields only — not plan, approval, billing,
      // identity/email, KYC documents, or an oversized fcmTokens array.
      // Cloud Functions (Admin SDK) bypass rules for PayMongo activation.
      allow update: if isAdmin() || (
        isOwner(shopId)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny([
              "subscriptionPlan",
              "subscriptionStatus",
              "subscriptionExpiry",
              "status",
              "email",
              "uid",
              "createdAt",
              "documents",
              "documentURL",
              "documentName",
            ])
        && request.resource.data.get("fcmTokens", []).size() <= 30
      ) || (
        isOwner(shopId)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "updatedAt"])
        && request.resource.data.status == "deleted"
      );

      allow delete: if isAdmin();

      // [App] Builder ratings, one document per builder, keyed by their uid.
      // Written by the builder app; the rating summary on the shop itself is
      // computed by the onShopRatingWritten Cloud Function.
      //
      // A rating is only allowed from someone who actually did business with
      // the shop: the document names the posted estimate it came from, and the
      // rules check that the estimate belongs to this builder and that this
      // shop is the one they selected on it. Without that check any account
      // could inflate a shop's score, or sink a competitor's.
      match /ratings/{builderId} {
        function ratedOwnCompletedProject() {
          let postId = request.resource.data.postId;
          let post = get(/databases/$(database)/documents/projectPosts/$(postId)).data;
          let shopUid = get(/databases/$(database)/documents/shops/$(shopId)).data.get('uid', shopId);
          let owner = post.get('userId', post.get('builderId', ''));
          let selected = post.get('selectedShopId', '');
          return owner == request.auth.uid
            && (selected == shopId || selected == shopUid);
        }

        // Ratings are public to signed-in users; that is the point of them.
        allow read: if signedIn();

        allow create, update: if signedIn()
          && builderId == request.auth.uid
          && request.resource.data.builderId == request.auth.uid
          && request.resource.data.shopId == shopId
          && request.resource.data.stars is int
          && request.resource.data.stars >= 1
          && request.resource.data.stars <= 5
          && request.resource.data.comment is string
          && request.resource.data.comment.size() <= 500
          && request.resource.data.postId is string
          && ratedOwnCompletedProject();

        // A builder may withdraw their own rating.
        allow delete: if isAdmin() || (signedIn() && builderId == request.auth.uid);
      }

      match /categories/{categoryId} {
        allow read: if isOwner(shopId) || isAdmin()
                    || get(/databases/$(database)/documents/shops/$(shopId)).data.status == "approved";
        allow write: if (isOwner(shopId) && shopIsApproved(shopId)) || isAdmin();
      }
    }

    // ── OTPs (email verification) — Cloud Functions / Admin SDK only ────────
    match /otps/{email} {
      allow read, write: if false;
    }

    match /email_otp/{email} {
      allow read, write: if false;
    }

    // PayMongo audit (Admin SDK only)
    match /paymongoActivations/{sessionId} {
      allow read, write: if false;
    }

    match /paymongoEvents/{eventId} {
      allow read, write: if false;
    }

    match /checkoutSessions/{sessionId} {
      allow read, write: if false;
    }

    // ── Subscription payments (manual GCash flow → admin review) ────────────
    // A shop may only create a *pending* request for a known paid plan; it may
    // not pre-set the status or forge the plan. Only admins confirm/reject.
    match /subscriptionPayments/{paymentId} {
      allow read: if isAdmin()
                  || (signedIn() && resource.data.shopId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.shopId == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.planName is string
        && request.resource.data.planName.lower() in ["pro", "business"]
        && request.resource.data.get("screenshotBase64", "").size() < 950000
        && request.resource.data.get("referenceNumber", "").size() <= 120;
      allow update, delete: if isAdmin();
    }

    // ── System config (plans, maintenance, etc.) ────────────────────────────
    match /systemConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /systemLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ── Products (web shops write; Flutter builders browse) ─────────────────
    match /products/{productId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.shopId == request.auth.uid
        && shopIsApproved(request.auth.uid);
      allow update: if signedIn()
        && resource.data.shopId == request.auth.uid
        && request.resource.data.shopId == request.auth.uid
        && shopIsApproved(request.auth.uid);
      allow delete: if signedIn()
        && resource.data.shopId == request.auth.uid
        && shopIsApproved(request.auth.uid);
    }

    // Template references used by the Flutter planner
    match /renovation_templates/{templateId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ── Builders / mobile app users ─────────────────────────────────────────
    // Profiles + fcmTokens live on users/{uid}. Nested drafts stay owner-only.
    // Owner must be able to list their own user doc + subcollections.
    // A profile is read only by its owner or an admin: any signed-in account
    // used to be able to fetch anyone's name, email, photo and push tokens by
    // uid. Others see a builder's name from the copy on their post or thread.
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      match /favorites/{favoriteId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }

      match /saved_projects/{projectId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }
    }

    // Same path as the nested match above. Listed twice so a collection query
    // on saved_projects cannot fall through a recursive default-deny.
    match /users/{userId}/saved_projects/{projectId} {
      allow read, write: if isOwner(userId);
    }

    // ── Project posts / quotations (web shops + Flutter builders) ───────────
    match /projectPosts/{postId} {
      // Posts stay private to the owning builder and approved shops that quote.
      allow get, list: if isAdmin()
        || isPostOwner(resource.data)
        || isApprovedShop();

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.projectName is string
        && request.resource.data.projectName.size() > 0
        && request.resource.data.projectName.size() <= 200
        && request.resource.data.materials is list
        && request.resource.data.materials.size() <= 500
        && request.resource.data.status == 'open'
        && request.resource.data.quotationCount == 0
        && !request.resource.data.keys().hasAny([
             'price', 'unitPrice', 'catalogPrice', 'estimatedTotal', 'listPrice'
           ]);

      // Admin; shop bid-counter bump; or the owning builder (accept offer, edits).
      allow update: if isAdmin()
        || (isApprovedShop()
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["quotationCount", "updatedAt"]))
        || (isPostOwner(resource.data)
            && request.resource.data.userId == resource.data.userId);

      allow delete: if isAdmin() || isPostOwner(resource.data);

      match /quotations/{quotationId} {
        allow get, list: if isAdmin()
          || (signedIn() && (
            ownsPostedEstimate(postId)
            || resource.data.shopId == request.auth.uid
            || request.auth.uid == quotationId
          ));

        // Matches the real payload written by insertQuotation(): shopId,
        // projectId, amount, status:"pending", items[]. The old version of
        // this rule required estimatedTotal/postId/status:"submitted" and an
        // auto-generated doc id equal to the shop's uid — fields the app has
        // never written, so every quote submission was silently rejected.
        allow create: if signedIn()
          && request.resource.data.shopId == request.auth.uid
          && shopIsApproved(request.auth.uid)
          && request.resource.data.projectId == postId
          && request.resource.data.amount is number
          && request.resource.data.amount >= 0
          && request.resource.data.status == 'pending';

        // Two writers, kept as separate branches so neither can borrow the
        // other's fields:
        // - The builder who posted the project decides a quote — full accept,
        //   reject, or partial accept (per-line items[].accepted +
        //   acceptedTotal, written by the builder app). Never shopConfirmation.
        // - After the builder accepts, the shop answers from the dashboard
        //   with shopConfirmation (confirmed / declined). Only that field, so
        //   a shop can never self-approve its bid or edit status, items or
        //   acceptedTotal.
        allow update: if isAdmin()
          || (ownsPostedEstimate(postId)
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status', 'acceptedAt', 'items', 'acceptedTotal'])
              && request.resource.data.status in ['accepted', 'rejected', 'partially_accepted']
              && request.resource.data.shopId == resource.data.shopId
              && request.resource.data.projectId == resource.data.projectId)
          || (signedIn()
              && resource.data.shopId == request.auth.uid
              && shopIsApproved(request.auth.uid)
              && resource.data.status in ['accepted', 'partially_accepted']
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['shopConfirmation', 'updatedAt'])
              && request.resource.data.shopConfirmation in ['confirmed', 'declined']);

        allow delete: if isAdmin()
          || (signedIn()
              && resource.data.shopId == request.auth.uid
              && shopIsApproved(request.auth.uid)
              && resource.data.status == 'pending');
      }

      match /acceptance/{acceptanceId} {
        allow read: if isAdmin()
          || (signedIn() && ownsPostedEstimate(postId))
          || (signedIn() && resource.data.shopId == request.auth.uid);
        allow create: if signedIn()
          && ownsPostedEstimate(postId)
          && request.resource.data.userId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Collection-group queries used by the web shop dashboard.
    // Builders only see quotes on their own posts; shops only see their own.
    match /{path=**}/quotations/{quotationId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.shopId == request.auth.uid)
        || (signedIn() && (
             resource.data.userId == request.auth.uid
             || resource.data.builderId == request.auth.uid
           ));

      allow create: if signedIn()
        && request.resource.data.keys().hasAll(["shopId"])
        && request.resource.data.shopId == request.auth.uid
        && shopIsApproved(request.auth.uid);
    }

    // Builder ↔ shop chat. Unlocks once a quotation is accepted by the
    // builder and confirmed by the shop.
    // Canonical builder uid is userId on the post; conversations store it as
    // builderId (and may also copy userId).
    match /conversations/{conversationId} {
      function isConvParticipant(data) {
        return signedIn() && (
          data.builderId == request.auth.uid
          || data.userId == request.auth.uid
          || data.shopId == request.auth.uid
        );
      }

      // The shop's answer to an accepted quotation. A quotation from before
      // shops confirmed has no field and counts as confirmed, matching
      // shopConfirmationOf() in lib/features/bidding/data/shop_confirmation.dart.
      function quotationIsConfirmed(projectId, quotationId) {
        return get(/databases/$(database)/documents/projectPosts/$(projectId)/quotations/$(quotationId))
          .data.get('shopConfirmation', 'confirmed') == 'confirmed';
      }

      function acceptedQuoteForConv() {
        return request.resource.data.projectId is string
          && request.resource.data.quotationId is string
          && exists(/databases/$(database)/documents/projectPosts/$(request.resource.data.projectId)/quotations/$(request.resource.data.quotationId))
          && get(/databases/$(database)/documents/projectPosts/$(request.resource.data.projectId)/quotations/$(request.resource.data.quotationId)).data.status in ['accepted', 'partially_accepted']
          && (
               get(/databases/$(database)/documents/projectPosts/$(request.resource.data.projectId)/quotations/$(request.resource.data.quotationId)).data.shopId == request.resource.data.shopId
               || request.resource.data.quotationId == request.resource.data.shopId
             )
          && quotationIsConfirmed(request.resource.data.projectId, request.resource.data.quotationId);
      }

      allow get: if isAdmin()
        || (signedIn() && (
             !exists(/databases/$(database)/documents/conversations/$(conversationId))
             || isConvParticipant(resource.data)
           ));
      allow list: if isAdmin() || isConvParticipant(resource.data);

      allow create: if signedIn()
        && (request.resource.data.builderId == request.auth.uid
            || request.resource.data.userId == request.auth.uid)
        && ownsPostedEstimate(request.resource.data.projectId)
        && request.resource.data.shopId is string
        && request.resource.data.shopId.size() > 0
        && request.resource.data.projectId is string
        && request.resource.data.status == 'open'
        && acceptedQuoteForConv();

      // Participants may update the thread summary and their own read marker.
      // shopLastReadAt / builderLastReadAt back the Sent / Seen indicators.
      // [App] readAt.<uid> backs the builder app's unread badges.
      allow update: if isAdmin()
        || (isConvParticipant(resource.data)
            && request.resource.data.shopId == resource.data.shopId
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['lastMessage', 'lastMessageAt', 'lastSenderId', 'updatedAt', 'status',
                           'shopLastReadAt', 'builderLastReadAt', 'readAt']));

      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAdmin()
          || isConvParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data);

        // A message carries text, an imageUrl, or both. Text (when present) is
        // a string <= 4000 chars; imageUrl (when present) is an https URL
        // <= 2000 chars. At least one of the two must be a non-empty string.
        //
        // Nobody can send until the shop has confirmed, even into a thread
        // that already exists (e.g. created early by the web Function). The
        // quotation is found from the parent thread; messages do not carry
        // projectId or quotationId themselves.
        allow create: if signedIn()
          && isConvParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data)
          && quotationIsConfirmed(
               get(/databases/$(database)/documents/conversations/$(conversationId)).data.projectId,
               get(/databases/$(database)/documents/conversations/$(conversationId)).data.quotationId
             )
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderRole in ['builder', 'shop']
          && (
               !('text' in request.resource.data)
               || (request.resource.data.text is string
                   && request.resource.data.text.size() <= 4000)
             )
          && (
               !('imageUrl' in request.resource.data)
               || (request.resource.data.imageUrl is string
                   && request.resource.data.imageUrl.size() <= 2000
                   && request.resource.data.imageUrl.matches('https://.*'))
             )
          // [App] A photo or document sent from the builder app, uploaded to
          // chat_attachments/ in Storage. Capped at the app's 10 MB limit.
          && (
               !('attachment' in request.resource.data)
               || (request.resource.data.attachment.url is string
                   && request.resource.data.attachment.url.size() > 0
                   && request.resource.data.attachment.url.size() <= 2000
                   && request.resource.data.attachment.name is string
                   && request.resource.data.attachment.name.size() <= 200
                   && request.resource.data.attachment.kind in ['image', 'file']
                   && request.resource.data.attachment.sizeBytes is int
                   && request.resource.data.attachment.sizeBytes >= 0
                   && request.resource.data.attachment.sizeBytes <= 10485760)
             )
          && (
               request.resource.data.get('text', '').size() > 0
               || request.resource.data.get('imageUrl', '').size() > 0
               || 'attachment' in request.resource.data
             );

        allow update, delete: if false;
      }
    }

    // ── Contact Us messages (web-only: public submit → admin inbox) ────────
    // Not used by the Flutter app. Anyone may create a well-formed message;
    // only admins can read / triage / delete.
    match /contactMessages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly([
          "name", "email", "subject", "message", "status", "createdAt"
        ])
        && request.resource.data.status == "new"
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 200
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 5000
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // In-app notifications — written by Cloud Functions (Admin SDK) only.
    match /notifications/{notificationId} {
      allow read: if signedIn()
        && resource.data.recipientId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.recipientId == resource.data.recipientId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['isRead']);
      allow create: if false;
      allow delete: if signedIn()
        && resource.data.recipientId == request.auth.uid;
    }

    // Unknown collections stay closed. Add an explicit match before shipping
    // a new one — coordinate with the web teammate first.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
