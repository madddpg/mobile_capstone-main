rules_version = '2';

// Shared Firebase project: web shop dashboard + Flutter builder app.
// Web owns shops / billing / products. Flutter owns estimates, posts, bids,
// notifications, and saved projects. Default-deny at the bottom — every
// collection used by either client must be listed here.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function shopIsApproved(shopId) {
      return shopId is string
        && exists(/databases/$(database)/documents/shops/$(shopId))
        && get(/databases/$(database)/documents/shops/$(shopId)).data.status is string
        && get(/databases/$(database)/documents/shops/$(shopId)).data.status.matches('(?i)^approved$');
    }

    function isApprovedShop() {
      return signedIn() && shopIsApproved(request.auth.uid);
    }

    // Builder uid on a posted estimate. Canonical field is userId (Auth uid).
    function isPostOwner(data) {
      return signedIn() && (
        data.userId == request.auth.uid
        || data.builderId == request.auth.uid
        || data.ownerId == request.auth.uid
        || data.postedBy == request.auth.uid
      );
    }

    function postDoc(postId) {
      return get(/databases/$(database)/documents/projectPosts/$(postId)).data;
    }

    function ownsPostedEstimate(postId) {
      return isPostOwner(postDoc(postId));
    }

    // ── Admins ──────────────────────────────────────────────────────────────
    match /admins/{adminId} {
      allow read: if isAdmin() || isOwner(adminId);
      allow write: if isAdmin();
    }

    // ── Shops (web dashboard + builder ranking of approved shops) ───────────
    match /shops/{shopId} {
      // Approved shops are readable by any signed-in user, not by the public.
      // Both screens that read this collection sit behind sign-in, so adding the
      // check costs the app nothing and stops the shop directory, addresses and
      // storefront details being scrapable by anyone with the project id.
      allow read: if isOwner(shopId) || isAdmin()
                  || (signedIn() && resource.data.status == "approved");

      // The rating summary. Only the Cloud Function writes it, from the
      // builders' own rating documents. A shop owner could otherwise give
      // their shop any score and climb the Top Shops list. The alternative
      // spellings are listed too, so no reader can be fed a score under a
      // name it might fall back to.
      function ratingFields() {
        return [
          "rating",
          "ratingCount",
          "ratingUpdatedAt",
          "averageRating",
          "ratingAverage",
          "ratingsCount",
          "reviewCount",
        ];
      }

      allow create: if isOwner(shopId)
        && request.resource.data.subscriptionPlan == "basic"
        && request.resource.data.status == "pending"
        && !request.resource.data.keys().hasAny(ratingFields());

      // Owners may edit profile fields only — not plan, approval, billing, or
      // rating. Cloud Functions (Admin SDK) bypass rules for PayMongo
      // activation and the rating summary.
      allow update: if isAdmin() || (
        isOwner(shopId)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny([
              "subscriptionPlan",
              "subscriptionStatus",
              "subscriptionExpiry",
              "status",
            ])
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(ratingFields())
      ) || (
        isOwner(shopId)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "updatedAt"])
        && request.resource.data.status == "deleted"
      );

      allow delete: if isAdmin();

      // Builder ratings, one document per builder, keyed by their uid.
      //
      // A rating is only allowed from someone who actually did business with
      // the shop: the document names the posted estimate it came from, and the
      // rules check that the estimate belongs to this builder and that this
      // shop is the one they selected on it. Without that check any account
      // could inflate a shop's score, or sink a competitor's.
      match /ratings/{builderId} {
        function ratedOwnCompletedProject() {
          let postId = request.resource.data.postId;
          let post = get(/databases/$(database)/documents/projectPosts/$(postId)).data;
          return post.userId == request.auth.uid
            && post.selectedShopId == shopId;
        }

        // Ratings are public to signed-in users; that is the point of them.
        allow read: if signedIn();

        allow create, update: if signedIn()
          && builderId == request.auth.uid
          && request.resource.data.builderId == request.auth.uid
          && request.resource.data.shopId == shopId
          && request.resource.data.stars is int
          && request.resource.data.stars >= 1
          && request.resource.data.stars <= 5
          && request.resource.data.comment is string
          && request.resource.data.comment.size() <= 500
          && request.resource.data.postId is string
          && ratedOwnCompletedProject();

        // A builder may withdraw their own rating. The Cloud Function
        // recomputes the average afterwards.
        allow delete: if isAdmin() || (signedIn() && builderId == request.auth.uid);
      }

      match /categories/{categoryId} {
        allow read: if isOwner(shopId) || isAdmin()
                    || get(/databases/$(database)/documents/shops/$(shopId)).data.status == "approved";
        allow write: if (isOwner(shopId) && shopIsApproved(shopId)) || isAdmin();
      }
    }

    // ── OTPs (email verification) — Cloud Functions / Admin SDK only ────────
    match /otps/{email} {
      allow read, write: if false;
    }

    match /email_otp/{email} {
      allow read, write: if false;
    }

    // PayMongo audit (Admin SDK only)
    match /paymongoActivations/{sessionId} {
      allow read, write: if false;
    }

    match /paymongoEvents/{eventId} {
      allow read, write: if false;
    }

    match /checkoutSessions/{sessionId} {
      allow read, write: if false;
    }

    // ── Subscription payments ───────────────────────────────────────────────
    match /subscriptionPayments/{paymentId} {
      allow read: if isAdmin()
                  || (signedIn() && resource.data.shopId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.shopId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ── System config (plans, maintenance, etc.) ────────────────────────────
    match /systemConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /systemLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ── Products (web shops write; Flutter builders browse) ─────────────────
    match /products/{productId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.shopId == request.auth.uid
        && shopIsApproved(request.auth.uid);
      allow update: if signedIn()
        && resource.data.shopId == request.auth.uid
        && request.resource.data.shopId == request.auth.uid
        && shopIsApproved(request.auth.uid);
      allow delete: if signedIn()
        && resource.data.shopId == request.auth.uid
        && shopIsApproved(request.auth.uid);
    }

    // AI usage counters. Written only by Cloud Functions through the Admin
    // SDK, which bypasses rules entirely. Clients get no access at all: a
    // client that could read its own counter learns the limit, and one that
    // could write it has no limit.
    match /ai_usage/{userId} {
      allow read, write: if false;
    }

    // Template references used by the Flutter planner
    match /renovation_templates/{templateId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ── Builders / mobile app users ─────────────────────────────────────────
    // Profiles + fcmTokens live on users/{uid}. Nested drafts stay owner-only.
    // Owner must be able to list their own user doc + subcollections.
    match /users/{userId} {
      allow get: if signedIn();
      allow list: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      match /favorites/{favoriteId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }

      match /saved_projects/{projectId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }
    }

    // Same path as the nested match above. Listed twice so a collection query
    // on saved_projects cannot fall through a recursive default-deny.
    match /users/{userId}/saved_projects/{projectId} {
      allow read, write: if isOwner(userId);
    }

    // ── Project posts / quotations (web shops + Flutter builders) ───────────
    match /projectPosts/{postId} {
      // Posts stay private to the owning builder and approved shops that quote.
      allow get, list: if isAdmin()
        || isPostOwner(resource.data)
        || isApprovedShop();

      // Shops quote estimates; they do not raise them. Without this an
      // approved shop could post an estimate, name itself the selected
      // supplier, and then leave itself a five-star rating, because the rating
      // rule trusts exactly those two facts.
      allow create: if signedIn()
        && !isApprovedShop()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.projectName is string
        && request.resource.data.projectName.size() > 0
        && request.resource.data.projectName.size() <= 200
        && request.resource.data.materials is list
        && request.resource.data.materials.size() <= 500
        && request.resource.data.status == 'open'
        && request.resource.data.quotationCount == 0
        && !request.resource.data.keys().hasAny([
             'price', 'unitPrice', 'catalogPrice', 'estimatedTotal', 'listPrice'
           ]);

      // Admin; shop bid-counter bump; or the owning builder (accept offer, edits).
      allow update: if isAdmin()
        || (isApprovedShop()
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["quotationCount", "updatedAt"]))
        || (isPostOwner(resource.data)
            && request.resource.data.userId == resource.data.userId
            // The create rule keeps prices off a posted estimate; the update
            // rule has to keep them off too, or they can simply be added the
            // moment after it is created.
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['price', 'unitPrice', 'catalogPrice',
                          'estimatedTotal', 'listPrice'])
            // Once a shop has quoted, the material list is what they quoted
            // against. Letting it change afterwards leaves quotations
            // describing a list that no longer exists, with neither side able
            // to tell.
            && (resource.data.get('quotationCount', 0) == 0
                || request.resource.data.materials == resource.data.materials)
            // A shop can only become the selected supplier if it actually
            // quoted. Quotation documents are keyed by shop id, so this is one
            // cheap existence check rather than a scan.
            && (!request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['selectedShopId'])
                || (exists(/databases/$(database)/documents/projectPosts/$(postId)/quotations/$(request.resource.data.selectedQuotationId))
                    && get(/databases/$(database)/documents/projectPosts/$(postId)/quotations/$(request.resource.data.selectedQuotationId)).data.shopId
                       == request.resource.data.selectedShopId)));

      allow delete: if isAdmin() || isPostOwner(resource.data);

      match /quotations/{quotationId} {
        allow get, list: if isAdmin()
          || (signedIn() && (
            ownsPostedEstimate(postId)
            || resource.data.shopId == request.auth.uid
            || request.auth.uid == quotationId
          ));

        // A quotation starts life as an open offer from the shop that sent
        // it, on an estimate that exists and has not chosen a supplier. It
        // cannot arrive already decided, carry an accepted total, sit under
        // another id, or use another shop's name. Any one of those would put a
        // decision on the builder's screen that the builder never made.
        allow create: if signedIn()
          && request.auth.uid == quotationId
          && request.resource.data.shopId == request.auth.uid
          && shopIsApproved(request.auth.uid)
          && request.resource.data.postId == postId
          && exists(/databases/$(database)/documents/projectPosts/$(postId))
          && postDoc(postId).get('selectedQuotationId', null) == null
          && !(postDoc(postId).get('status', 'open') in
               ['offer_accepted', 'awarded', 'closed', 'cancelled', 'withdrawn'])
          && request.resource.data.status == 'submitted'
          && request.resource.data.estimatedTotal is number
          && request.resource.data.estimatedTotal >= 0
          && !request.resource.data.keys().hasAny(['acceptedTotal', 'acceptedAt'])
          && (!('shopName' in request.resource.data)
              || request.resource.data.shopName
                   == get(/databases/$(database)/documents/shops/$(request.auth.uid)).data.get('shopName', null));

        allow update: if isAdmin()
          // A shop may revise its own offer while it is still open. Once the
          // builder has decided, the quotation stops being an offer and starts
          // being the record of what was agreed, so the shop can no longer
          // touch it. Without this a shop could raise the price after
          // acceptance, or turn back on the lines the builder unticked, and
          // the document would simply claim that was the deal.
          || (signedIn()
              && resource.data.shopId == request.auth.uid
              && shopIsApproved(request.auth.uid)
              && request.resource.data.shopId == resource.data.shopId
              && request.resource.data.postId == resource.data.postId
              && !(resource.data.get('status', 'submitted') in
                   ['accepted', 'partially_accepted', 'rejected'])
              // Any decision, accepting or rejecting, is the builder's act. A
              // shop's revision stays an open offer.
              && request.resource.data.get('status', 'submitted') == 'submitted'
              && request.resource.data.estimatedTotal is number
              && request.resource.data.estimatedTotal >= 0
              && !request.resource.data.diff(resource.data).affectedKeys()
                   .hasAny(['acceptedTotal', 'acceptedAt'])
              && (!request.resource.data.diff(resource.data).affectedKeys()
                     .hasAny(['shopName'])
                  || request.resource.data.shopName
                       == get(/databases/$(database)/documents/shops/$(request.auth.uid)).data.get('shopName', null)))
          // The builder may accept a quotation whole or line by line. Partial
          // acceptance rewrites the items array with an `accepted` flag on each
          // entry and records what the kept lines come to, so those two fields
          // join the allowed set. The builder still cannot touch price fields,
          // shopId or postId.
          || (ownsPostedEstimate(postId)
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status', 'acceptedAt', 'items', 'acceptedTotal'])
              && request.resource.data.status
                   in ['accepted', 'partially_accepted', 'rejected']
              && request.resource.data.shopId == resource.data.shopId
              && request.resource.data.postId == resource.data.postId
              && request.resource.data.estimatedTotal == resource.data.estimatedTotal
              && (!('items' in request.resource.data.diff(resource.data).affectedKeys())
                  || (request.resource.data.items is list
                      && request.resource.data.items.size() == resource.data.items.size()))
              && (!('acceptedTotal' in request.resource.data.diff(resource.data).affectedKeys())
                  || (request.resource.data.acceptedTotal is number
                      && request.resource.data.acceptedTotal >= 0
                      && request.resource.data.acceptedTotal <= resource.data.estimatedTotal)));

        allow delete: if isAdmin()
          || (signedIn()
              && resource.data.shopId == request.auth.uid
              && shopIsApproved(request.auth.uid));
      }

      match /acceptance/{acceptanceId} {
        allow read: if isAdmin()
          || (signedIn() && ownsPostedEstimate(postId))
          || (signedIn() && resource.data.shopId == request.auth.uid);
        allow create: if signedIn()
          && ownsPostedEstimate(postId)
          && request.resource.data.userId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Collection-group queries used by the web shop dashboard.
    // Builders only see quotes on their own posts; shops only see their own.
    //
    // Read only. A query never writes, and the create this block used to hold
    // matched every quotation path in the database. Rules allow a write when
    // any matching rule does, so it let an approved shop skip every check in
    // the per-post rule: a quotation already marked accepted, any number of
    // quotations per estimate, quotations on estimates that do not exist, and
    // "quotations" collections anywhere at all.
    match /{path=**}/quotations/{quotationId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.shopId == request.auth.uid)
        || (signedIn() && (
             resource.data.userId == request.auth.uid
             || resource.data.builderId == request.auth.uid
           ));
    }

    // Builder ↔ shop chat. Unlocks after a quotation is accepted.
    // Canonical builder uid is userId on the post; conversations store it as
    // builderId (and may also copy userId).
    match /conversations/{conversationId} {
      function isConvParticipant(data) {
        return signedIn() && (
          data.builderId == request.auth.uid
          || data.userId == request.auth.uid
          || data.shopId == request.auth.uid
        );
      }

      function acceptedQuoteForConv() {
        return request.resource.data.projectId is string
          && request.resource.data.quotationId is string
          && exists(/databases/$(database)/documents/projectPosts/$(request.resource.data.projectId)/quotations/$(request.resource.data.quotationId))
          // A builder who kept only some lines is still buying from this shop
          // and needs to talk to them about delivery and the dropped lines.
          && get(/databases/$(database)/documents/projectPosts/$(request.resource.data.projectId)/quotations/$(request.resource.data.quotationId)).data.status
               in ['accepted', 'partially_accepted']
          && (
               get(/databases/$(database)/documents/projectPosts/$(request.resource.data.projectId)/quotations/$(request.resource.data.quotationId)).data.shopId == request.resource.data.shopId
               || request.resource.data.quotationId == request.resource.data.shopId
             );
      }

      allow get: if isAdmin()
        || (signedIn() && (
             !exists(/databases/$(database)/documents/conversations/$(conversationId))
             || isConvParticipant(resource.data)
           ));
      allow list: if isAdmin() || isConvParticipant(resource.data);

      allow create: if signedIn()
        && (request.resource.data.builderId == request.auth.uid
            || request.resource.data.userId == request.auth.uid)
        && ownsPostedEstimate(request.resource.data.projectId)
        && request.resource.data.shopId is string
        && request.resource.data.shopId.size() > 0
        && request.resource.data.projectId is string
        && request.resource.data.status == 'open'
        && acceptedQuoteForConv();

      allow update: if isAdmin()
        || (isConvParticipant(resource.data)
            && request.resource.data.shopId == resource.data.shopId
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['lastMessage', 'lastMessageAt', 'lastSenderId', 'updatedAt', 'status', 'readAt']));

      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAdmin()
          || isConvParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data);

        allow create: if signedIn()
          && isConvParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000
          && request.resource.data.senderRole in ['builder', 'shop']
          // A message must carry words, an attachment, or both. Requiring text
          // outright would reject a photo sent with no caption.
          && (request.resource.data.text.size() > 0
              || request.resource.data.keys().hasAny(['attachment']))
          && (!request.resource.data.keys().hasAny(['attachment'])
              || (request.resource.data.attachment.url is string
                  && request.resource.data.attachment.url.size() > 0
                  && request.resource.data.attachment.url.size() <= 2000
                  && request.resource.data.attachment.name is string
                  && request.resource.data.attachment.name.size() <= 200
                  && request.resource.data.attachment.kind in ['image', 'file']
                  && request.resource.data.attachment.sizeBytes is int
                  && request.resource.data.attachment.sizeBytes >= 0
                  && request.resource.data.attachment.sizeBytes <= 10485760));

        allow update, delete: if false;
      }
    }

    // In-app notifications — written by Cloud Functions (Admin SDK) only.
    match /notifications/{notificationId} {
      allow read: if signedIn()
        && resource.data.recipientId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.recipientId == resource.data.recipientId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['isRead']);
      allow create: if false;
      allow delete: if signedIn()
        && resource.data.recipientId == request.auth.uid;
    }

    // Unknown collections stay closed. Add an explicit match before shipping
    // a new one — coordinate with the web teammate first.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
