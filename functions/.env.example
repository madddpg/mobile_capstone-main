# Copy to functions/.env and fill in. functions/.env is not committed.
#
# Only non-secret settings belong here. API keys are Firebase secrets:
#   firebase functions:secrets:set BREVO_API_KEY   (one-time code emails)
#   firebase functions:secrets:set GEMINI_API_KEY  (iConstruct AI)
# Never add either key to this file as well. A variable that is both a secret
# and a plain setting makes every deploy fail with "Secret environment
# variable overlaps non secret environment variable".
#
# Keep a functions/.env even if it only holds the sender below. Without any
# .env file, the Firebase CLI copies the environment variables of the
# functions already deployed into each new deploy, including stale ones.

BREVO_SENDER_NAME=iConstruct
# Must be a sender verified in the Brevo account, or Brevo rejects every email.
BREVO_SENDER_EMAIL=you@example.com

# Optional fallback if Gemini fails. A plain setting, since it is not declared
# as a secret in index.js.
# OPENAI_API_KEY=
