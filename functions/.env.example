EMAIL_FROM=iConstruct <onboarding@resend.dev>

# Required for iConstruct AI (Gemini via Google AI Studio — no custom training)
# firebase functions:secrets:set GEMINI_API_KEY
GEMINI_API_KEY=

# Optional fallback if Gemini fails
# OPENAI_API_KEY=

# Brevo sends the one-time codes for registration and password reset.
# Stored as a secret, not in this file, so it survives deploys from any machine:
#   firebase functions:secrets:set BREVO_API_KEY
#
# Optional, plain config rather than secrets. Without them the sender falls
# back to no-reply@iconstruct.app.
# BREVO_SENDER_NAME=iConstruct
# BREVO_SENDER_EMAIL=no-reply@iconstruct.app
